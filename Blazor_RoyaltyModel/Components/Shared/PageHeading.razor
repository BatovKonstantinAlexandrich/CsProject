<header class="page-head">
    <div class="wrap">
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <p>@Lead</p>
        }
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Lead { get; set; }
}
