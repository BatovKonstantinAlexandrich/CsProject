@inject IContentService Content

<section class="wrap feature-grid">
    @foreach (var card in Content.GetFeatures())
    {
        <article class="feature-card @card.Tone">
            <div>
                <h2>@card.Title</h2>
                <p>@card.Text</p>
                <a class="btn-pill light" href="@card.Href">@card.Button</a>
            </div>
            @if (card.Tone == "dark")
            {
                <svg class="feature-art" viewBox="0 0 280 160" aria-hidden="true">
                    <path d="M20 120h240" stroke="#9aa3b2" stroke-width="4" />
                    <path d="M40 120 V78 l30-28h70l24 28h70v42z" fill="#e23b3b" />
                    <circle cx="78" cy="120" r="16" fill="#1c1f27" />
                    <circle cx="196" cy="120" r="16" fill="#1c1f27" />
                    <path d="M150 92h40v18h-48z" fill="#d7dee8" />
                </svg>
            }
        </article>
    }
</section>
