@inject IContentService Content

<section class="hero">
    <div class="wrap hero-grid">
        <div>
            <h1>@hero.Title</h1>
            <p class="hero-lead">@hero.Subtitle</p>
            <a class="btn-pill" href="@hero.ButtonHref">@hero.ButtonText</a>
        </div>
        <div class="hero-art" aria-hidden="true">
            <svg viewBox="0 0 560 460">
                <circle cx="300" cy="210" r="180" fill="#eef3f8" />
                <rect x="250" y="70" width="18" height="250" rx="6" fill="#2c313c" />
                <rect x="430" y="70" width="18" height="250" rx="6" fill="#2c313c" />
                <rect x="220" y="78" width="250" height="16" rx="6" fill="#3a4150" />
                <rect x="236" y="188" width="230" height="14" rx="5" fill="#4b5568" />
                <path d="M150 250c20-70 70-110 140-110h90c40 0 70 18 90 48l30 52H150z" fill="#3ec3f3" />
                <path d="M210 168h70c18 0 28 16 22 32l-8 20H190l8-28c4-14 10-24 12-24z" fill="#dff6ff" />
                <circle cx="230" cy="268" r="32" fill="#1d212b" />
                <circle cx="230" cy="268" r="14" fill="#d5dbe6" />
                <circle cx="430" cy="268" r="32" fill="#1d212b" />
                <circle cx="430" cy="268" r="14" fill="#d5dbe6" />
                <path d="M250 330h150v18H250z" fill="#2c313c" />
            </svg>
            <span class="badge badge-a"><EaIcon Name="spark" /></span>
            <span class="badge badge-b"><EaIcon Name="diag" /></span>
            <span class="badge badge-c"><EaIcon Name="battery" /></span>
        </div>
    </div>
</section>

@code {
    private HeroContent hero = new("", "", "", "/");

    protected override void OnInitialized() => hero = Content.GetHero();
}
