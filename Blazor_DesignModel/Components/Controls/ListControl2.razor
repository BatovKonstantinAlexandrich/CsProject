@using MudBlazor
@code
{
    [Parameter]
    public string Title { get; set; } = "Список";

    [Parameter]
    public List<string> Options { get; set; }
}
<MudList T="string" @bind-SelectedValue="Selected" Clickable="true" >

    <MudListSubheader>
        @Title
    </MudListSubheader>

    @if (Options is not null)
    {
        @foreach (var option in Options)
        {
            <MudListItem T="string" Value="@(option)" Text="@option" />       
        }
    }        
</MudList>

<MudText Class="mt-4">Выбрано: @(Selected ?? "ничего")</MudText>

@code {
    private string? Selected { get; set; }
}