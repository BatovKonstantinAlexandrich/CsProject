@page "/registration"
@using ApplicationDb.Entities
@inject SignupUser signupUser
<div style="padding: 20px; width: 100%; max-width: 640px;">
    <h2 class="display-5">Регистрация</h2>
    <p class="text-muted">Создание учётной записи на ресурсе.</p>

    @if (Success)
    {
        <div class="alert alert-success" role="alert">@SuccessMessage</div>
        <a class="btn btn-primary" href="/signin">Перейти к входу</a>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger" role="alert">@Error</div>
        }

        <form @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
            <h4 class="mt-3">Учётная запись</h4>

            <div class="form-group">
                <label for="inputEmail">@_labelEmail</label>
                <input @bind="Model.Email"
                       type="email"
                       class="form-control @(HasFieldErrors(nameof(RegistrationPageModel.Email)) ? "is-invalid" : "")"
                       id="inputEmail"
                       placeholder="@_labelEmail"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(RegistrationPageModel.Email)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpEmail</small>
            </div>

            <div class="form-group">
                <label for="inputPassword">@_labelPassword</label>
                <input @bind="Model.Password"
                       type="password"
                       class="form-control @(HasFieldErrors(nameof(RegistrationPageModel.Password)) ? "is-invalid" : "")"
                       id="inputPassword"
                       placeholder="@_labelPassword"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(RegistrationPageModel.Password)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpPassword</small>
            </div>

            <div class="form-group">
                <label for="inputPasswordConfirm">@_labelPasswordConfirm</label>
                <input @bind="Model.PasswordConfirmation"
                       type="password"
                       class="form-control @(HasFieldErrors(nameof(RegistrationPageModel.PasswordConfirmation)) ? "is-invalid" : "")"
                       id="inputPasswordConfirm"
                       placeholder="@_labelPasswordConfirm"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(RegistrationPageModel.PasswordConfirmation)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
            </div>

            <h4 class="mt-4">Личные данные</h4>

            <div class="form-group">
                <label for="inputSurName">@_labelSurName</label>
                <input @bind="Model.Person.SurName"
                       type="text"
                       class="form-control @(HasFieldErrors(nameof(UserPerson.SurName)) ? "is-invalid" : "")"
                       id="inputSurName"
                       placeholder="@_labelSurName"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(UserPerson.SurName)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpSurName</small>
            </div>

            <div class="form-group">
                <label for="inputFirstName">@_labelFirstName</label>
                <input @bind="Model.Person.FirstName"
                       type="text"
                       class="form-control @(HasFieldErrors(nameof(UserPerson.FirstName)) ? "is-invalid" : "")"
                       id="inputFirstName"
                       placeholder="@_labelFirstName"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(UserPerson.FirstName)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpFirstName</small>
            </div>

            <div class="form-group">
                <label for="inputLastName">@_labelLastName</label>
                <input @bind="Model.Person.LastName"
                       type="text"
                       class="form-control @(HasFieldErrors(nameof(UserPerson.LastName)) ? "is-invalid" : "")"
                       id="inputLastName"
                       placeholder="@_labelLastName"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(UserPerson.LastName)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpLastName</small>
            </div>

            <div class="form-group">
                <label for="inputBirthday">@_labelBirthday</label>
                <input @bind="Model.Person.Birthday"
                       type="date"
                       class="form-control @(HasFieldErrors(nameof(UserPerson.Birthday)) ? "is-invalid" : "")"
                       id="inputBirthday"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(UserPerson.Birthday)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpBirthday</small>
            </div>

            <div class="form-group">
                <label for="inputTel">@_labelTel</label>
                <input @bind="Model.Person.Tel"
                       type="tel"
                       class="form-control @(HasFieldErrors(nameof(UserPerson.Tel)) ? "is-invalid" : "")"
                       id="inputTel"
                       placeholder="@_labelTel"
                       disabled="@IsSubmitting" />
                @foreach (var message in GetFieldErrors(nameof(UserPerson.Tel)))
                {
                    <small class="form-text text-danger d-block">@message</small>
                }
                <small class="form-text text-muted">@_helpTel</small>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                    @(IsSubmitting ? "Регистрация…" : "Зарегистрироваться")
                </button>
                <a class="btn btn-link" href="/signin">Уже есть учётная запись</a>
            </div>
        </form>
    }
</div>

@code {
    private RegistrationPageModel Model { get; set; } = new RegistrationPageModel();
    private Dictionary<string, List<string>> FieldErrors { get; set; } = new Dictionary<string, List<string>>();
    private string Error { get; set; }
    private string SuccessMessage { get; set; }
    private bool Success { get; set; }
    private bool IsSubmitting { get; set; }

    private string _labelEmail, _helpEmail;
    private string _labelPassword, _helpPassword;
    private string _labelPasswordConfirm;
    private string _labelSurName, _helpSurName;
    private string _labelFirstName, _helpFirstName;
    private string _labelLastName, _helpLastName;
    private string _labelBirthday, _helpBirthday;
    private string _labelTel, _helpTel;

    protected override void OnInitialized()
    {
        var accountType = typeof(UserAccount);
        _labelEmail = Attrs.LabelFor(accountType, nameof(UserAccount.Email));
        _helpEmail = Attrs.HelpFor(accountType, nameof(UserAccount.Email));
        _labelPassword = Attrs.LabelFor(accountType, nameof(UserAccount.Password));
        _helpPassword = Attrs.HelpFor(accountType, nameof(UserAccount.Password));
        _labelPasswordConfirm = "Подтверждение пароля";

        var personType = typeof(UserPerson);
        _labelSurName = Attrs.LabelFor(personType, nameof(UserPerson.SurName));
        _helpSurName = Attrs.HelpFor(personType, nameof(UserPerson.SurName));
        _labelFirstName = Attrs.LabelFor(personType, nameof(UserPerson.FirstName));
        _helpFirstName = Attrs.HelpFor(personType, nameof(UserPerson.FirstName));
        _labelLastName = Attrs.LabelFor(personType, nameof(UserPerson.LastName));
        _helpLastName = Attrs.HelpFor(personType, nameof(UserPerson.LastName));
        _labelBirthday = Attrs.LabelFor(personType, nameof(UserPerson.Birthday));
        _helpBirthday = Attrs.HelpFor(personType, nameof(UserPerson.Birthday));
        _labelTel = Attrs.LabelFor(personType, nameof(UserPerson.Tel));
        _helpTel = Attrs.HelpFor(personType, nameof(UserPerson.Tel));
    }

    private async Task OnSubmit()
    {
        Error = null;
        Success = false;
        FieldErrors = new Dictionary<string, List<string>>();
        IsSubmitting = true;

        try
        {
            var result = signupUser.Register(Model);
            if (result.Success)
            {
                Success = true;
                SuccessMessage = result.Message;
            }
            else
            {
                Error = result.Message;
                FieldErrors = result.Errors.ToDictionary(
                    e => e.Key,
                    e => e.Value,
                    StringComparer.OrdinalIgnoreCase);
            }
        }
        catch (Exception ex)
        {
            Error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            IsSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool HasFieldErrors(string field) =>
        FieldErrors != null && FieldErrors.ContainsKey(field) && FieldErrors[field].Count > 0;

    private IEnumerable<string> GetFieldErrors(string field)
    {
        if (FieldErrors != null && FieldErrors.TryGetValue(field, out var messages) && messages != null)
            return messages;
        return Array.Empty<string>();
    }
}
