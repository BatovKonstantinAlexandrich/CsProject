        new SelectableListItem<BusinessFunction>(){ Item = new BusinessFunction(){ Name = "Отменить заказ" } }
    };
    public void OnBusinessFunctionSelected(BusinessFunction businessFunction)
    {
        //modal.ConfirmDialog(businessFunction.Name, businessFunction.Name);
    }
}

<SelectList 
