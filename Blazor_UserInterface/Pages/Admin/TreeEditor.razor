@page "/admin/tree-editor"
@code
{
    [Parameter]
    public ContainerFluid Container { get; set; }


    public bool ShowLeft { get; set; } = true;
    public bool ShowRight { get; set; } = true;

    [Parameter]
    public global::Tree Model { get; set; } = new global::Tree() {
        Item = new NamedObject() {
            Name = "Каталог"
        }
    };
}

<ContainerFluid ShowLeft="@ShowLeft" ShowRight="@ShowRight">
    <Left>        
        <button style="width: 100%; height: 100%;">left</button>
    </Left>
    <Center>
        
        <span style="width: 100%; height: 100%;" class="material-icon" @onclick="@OnMenuClicked">menu</span>
    </Center>
    <Right>
        <button style="width: 100%; height: 100%;">ok</button>
    </Right>
</ContainerFluid>
@code 
{
    public void OnMenuClicked()
    {
        this.ShowLeft = this.ShowLeft ? false : true;
    }
}
