@page "/restore"
@inject AuthorizationService registration

<div style="padding: 20px; max-width: 480px;">
    <h2>Восстановление пароля</h2>
    <p class="text-muted">На ваш e-mail будет отправлен новый пароль.</p>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert">@Error</div>
    }

    <form @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
        <div class="form-group">
            <label for="restoreEmail">E-mail</label>
            <input id="restoreEmail"
                   type="email"
                   class="form-control"
                   @bind="Email"
                   disabled="@IsSubmitting" />
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                @(IsSubmitting ? "Отправка…" : "Восстановить")
            </button>
            <a class="btn btn-link" href="/signin">Вернуться ко входу</a>
        </div>
    </form>
</div>

@code {
    private string Email { get; set; }
    private string Error { get; set; }
    private string SuccessMessage { get; set; }
    private bool IsSubmitting { get; set; }

    private async Task OnSubmit()
    {
        Error = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(Email))
        {
            Error = "Укажите адрес электронной почты.";
            return;
        }

        IsSubmitting = true;
        try
        {
            registration.RestorePasswordByEmail(Email.Trim());
            SuccessMessage = "Если учётная запись существует, новый пароль отправлен на указанный e-mail.";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
