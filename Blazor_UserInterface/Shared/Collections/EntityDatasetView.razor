@typeparam TEntity
@inject IEntityRepository<TEntity> repository
@code
{
    /// <summary>
    /// Инициаллизация
    /// </summary>    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await this.UpdateAsync();
    }


    /// <summary>
    /// Обновление страницы
    /// </summary>    
    public async Task UpdateAsync()
    {
        this.Dataset = (await repository.Get()).Select(i => new TableRow((object)i)).ToArray();
        this.Columns = typeof(TEntity).GetUserInputPropertyNames().Select(name => new TableColumn()
        {
            Name = name,
            Label = Utils.LabelFor(typeof(TEntity), name),
            Icon = Utils.IconFor(typeof(TEntity), name)

        }).ToArray();
    }
}
@code
{
    [Parameter]
    public bool ShowRight { get; set; }

    [Parameter]
    public TableColumn[] Columns { get; set; }

    [Parameter]
    public TableRow[] Dataset { get; set; }

}
<TransclusionPanel ShowRight="@ShowRight" ShowLeft="false">
    <Header>
        <Toolbar>
            <MatToogle Icon="create" IsActive="@ShowRight" OnClickedEventCallback="@OnCreateClicked"></MatToogle>  
        </Toolbar>

    </Header>
    <ChildContent>
        @if (Columns != null)
        {
            <EntityTableView TEntity="@TEntity"></EntityTableView>
        }        
    </ChildContent>
    <Footer>

    </Footer>
    <Right>
        <CreateForm TypeName="@(typeof(TEntity).Name)" 
                    OnCreate="@OnCreateCompleted"
                    OnCancel="@OnCreateCanceled">
        </CreateForm>
    </Right>
</TransclusionPanel>
@functions
{       
    public Task OnCreateClicked(bool state)
    {
        return Task.Run(() =>
        {
            this.ShowRight = state;
        });
    }
    public Task OnCreateCanceled()
    {
        return Task.Run(() =>
        {
            this.ShowRight = false;
        });
    }
    public async Task OnCreateCompleted(object item)
    {
        await repository.Create((TEntity)item);
        await this.UpdateAsync();
        ShowRight = false;
    }
}