@code {
    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback<bool> OnClickedEventCallback { get; set; }
}

<button class="btn @(IsActive ? "btn-primary": "")" @onclick="@OnClicked">
    <i class="material-icons">@Icon</i>
</button>


@functions 
{
    public async Task OnClicked()
    {        
        await OnClickedEventCallback.InvokeAsync((IsActive = IsActive ? false : true));
    }
}
