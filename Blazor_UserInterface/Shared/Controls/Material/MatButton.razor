<button class="btn front-pane" 
        style="padding: 3px;" 
        @onclick="@OnClicked"
        @onclick:preventDefault>
    <i class="material-icons" style="padding:0px; font-size: 18px; @(Color!=null?"color: "+Color:"")">@Icon</i>
</button>

@code {
    [Parameter]
    public string Icon { get; set; }

    [Parameter]
    public string Color { get; set; }

    [Parameter]
    public string BackgroundColor { get; set; }

    [Parameter]
    public EventCallback OnClicked { get; set; }
}
