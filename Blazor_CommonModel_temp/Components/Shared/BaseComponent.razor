@inject IJSRuntime JSR
<h3>BaseComponent</h3>

@code {
    [Parameter]
    public EventCallback<object> OnEvent { get; set; }

    [Parameter]
    public EventCallback<BaseComponent> OnInit { get; set; }

    public BaseComponent Parent { get; set; }
    public List<BaseComponent> Children { get; set; } = new List<BaseComponent>();

    /// <summary>
    /// Метод упрощает написание кода в дочерних классах, т.к. OnInitializedAsync() трудно запомнить
    /// </summary>
    public virtual void AfterInit() { }

    public int Status { get; set; } = 200;
    public string StatusMessage { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        Info("OnInitializedAsync");
        await OnInit.InvokeAsync(this);
        this.AfterInit();
    }

    public async Task OnChildInitiallized(BaseComponent child)
    {
        Info($"OnChildInitiallized({child.GetHashCode()})");
        if (child.Parent != null)
        {
            child.Parent.Children.Remove(child.Parent);
        }
        child.Parent = this;
        Children.Add(child);
        await OnInit.InvokeAsync(child);
    }

    public async Task OnEventSubmited(object evt)
    {
        Info($"OnEventSubmited({evt.GetHashCode()})");
        await OnEvent.InvokeAsync(evt);
    }

    public void Error(Exception ex)
    {
        Console.WriteLine($"[{GetType().GetTypeName()}]: {ex.Message}");
        Console.WriteLine($"[{GetType().GetTypeName()}]: {ex.StackTrace}");
    }

    public void Info(object item)
    {
        Console.WriteLine($"[{GetType().GetTypeName()}]: {item}");
    }

    public async Task<T> Eval<T>( string js )
    {
        Info($"Eval({js})");
        return await JSR.InvokeAsync<T>("eval",@"(function () {            
            try {
                " +js+@"    
            } catch (e) {
                alert('Ошибка при разборе JSON: ' + e);
            }             
        })()");
    }

    public async Task<T> EvalAsync<T>( string js )
    {
        Info($"Eval({js})");
        return await JSR.InvokeAsync<T>("eval",@"(function () {            
            try {
                " +js+@"    
            } catch (e) {
                alert('Ошибка при разборе JSON: ' + e);
            }             
        })()");
    }

}
