    private async Task ShowInputDialogAsync()
    {
        var controlTypes = ServiceFactory.Get().GetTypes().Where(t => t.Namespace == "Blazor_CommonModel.Shared.FormFields").Select(p => p.GetTypeName()).ToList();
        var view = new AppViewBase();
        var card = new CardView();

        view.Append(card);
        var combobox = view.CreateCombobox("Тип", new(controlTypes), selected =>
        {
            
            try
            {
                MethodBase.GetCurrentMethod();
                card.LayoutFill(selected.Replace("Control", "View").ToType().New<AppViewBase>());
            }
            catch (Exception ex)
            {
                this.Error(ex);
            }
        });
        view.LayoutTop(combobox);

        var ptype = controlTypes.First();
        var pview = ptype.Replace("Control","View").ToType().New<AppViewBase>();
        card.LayoutFill(pview);

        var parameters = new DialogParameters<SubmitDialog>       
        {
            { x => x.ViewModel, view }
        };

        var value = await ((AppModalService)clientModal).ShowDialogAsync<SubmitDialog, string>(
            "Редактирование",
            parameters);

        object _lastDialogResult = value is null
            ? "Диалог ввода отменён."
            : $"Сохранено значение: «{value}»";
    }

