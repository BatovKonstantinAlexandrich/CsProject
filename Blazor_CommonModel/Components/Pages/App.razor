@code
{

    public BaseComponent DesignerControl { get; set; }
    public AppViewBase DesignerModel { get; set; }
    public List<RenderFragment> RenderFragments { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        this.Info("OnInitializedAsync");
        await base.OnInitializedAsync();
               
        DesignerModel = new AppViewRoot();


        foreach (var ptype in ServiceFactory.Get().GetTypes().Where(t => t.Namespace == "Blazor_CommonModel.Shared.FormFields"))
        {
            try
            {
                var viewType = ptype.BaseType.GetGenericArguments()[0];
                DesignerModel.Append(viewType.New<AppViewBase>());
            }
            catch(Exception ex)
            {
            }

        }

        
    }
    
    public CommonModel SharedComponentRef { get; set; }
    public RenderFragment Cursor { get; set; }
}    

@if (Cursor is not null)
{
    @Cursor
}



