{
    public AppViewBase ViewRef { get; set; } = new();
    public AppViewRoot ViewRootRef { get; set; } = new ();
    public AppViewRoot DesignerViewRef { get; set; }
    private DotNetObjectReference<Index>? _objRef;


    private string LastKey = "—";
    private string LastCode = "—";


    [JSInvokable]
    public Task OnKeyDown(string key, string code)
    {
        LastKey = key;
        LastCode = code;


        this.DesignerViewRef.OnKeyDown(this.DesignerViewRef, new()
            {
                KeyCodeStr = code
            });
        StateHasChanged();
        return Task.CompletedTask;
    }


    [JSInvokable]
    public Task OnKeyPress(string key, string code)
    {
        LastKey = key;
        LastCode = code;
        if (code.StartsWith("Key"))
            code = code.Substring(3).ToLower();
        this.DesignerViewRef.OnKeyPressed(this.DesignerViewRef, new()
            {
                KeyChar = code
            });
        StateHasChanged();
        return Task.CompletedTask;
    }


    [JSInvokable]
    public Task OnKeyUp(string key, string code)
    {
        LastKey = key;
        LastCode = code;
        this.DesignerViewRef.OnKeyUp(this.DesignerViewRef, new()
            {
                KeyCodeStr = code
            });
        StateHasChanged();
        return Task.CompletedTask;
    }


