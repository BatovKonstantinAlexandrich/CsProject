@code
{
    public bool Active = true;
    public StatusControl StatusControlRef { get; set; }
    protected override async Task OnInitializedAsync()
    {
        DesignerViewRef = new DesignerView();

        await base.OnInitializedAsync();

        var designer = DesignerViewRef;


        _objRef = DotNetObjectReference.Create(this);

        this.OnRendered += async () =>
        {
            await JS.InvokeVoidAsync("keyboardHandler.register", _objRef);
        };

        designer.keyboardConfig["q"] = () =>
        {
            designer.DesignMode = !designer.DesignMode;

        };
        DesignerViewRef.StatusView.OnChange += evt => StateHasChanged();
        designer.Name = nameof(AppViewRoot);
        if (designer.GetAppRootView() != designer)
            throw new Exception("designer.GetAppRootView() != designer");
        designer.Append(designer.CreateButton("Диалог", async () => {
            Active = Active ? false : true;
            DesignerViewRef.StatusView.Active = DesignerViewRef.StatusView.Active?false:true;
            StateHasChanged();
        }));
        designer.Append(designer.CreateButton("Бизнес моделирование", async () =>
        {
            designer.Cast<DesignerView>().OnNavSelected("Бизнес моделирование");
        }));
        designer.Append(designer.CreateButton("Регистрация", async () =>
        {
            designer.LayoutFill(new BusinessModelView());
        }));

        designer.LayoutTop(new ButtonView(){
            OnClick = (p,e)=> {
                    designer.Cast<DesignerView>().AddNavOption("Бизнес моделирование", new BusinessModelView());
                    designer.Cast<DesignerView>().OnNavSelected("Бизнес моделирование");
            }
        });
        designer.Cast<DesignerView>().AddNavOption("Личный кабинет", new UserHomeView());
        // designer.Cast<DesignerView>().AddNavOption("Вход", signIn);
        designer.Cast<DesignerView>().AddNavOption("Бизнес моделирование", new BusinessModelView());
        designer.Cast<DesignerView>().AddNavOption("Регистрация", new UserSignupView<DeliveryDbContext>());
        var signin = new UserSigninView<DeliveryDbContext>();

        var editView = EditView.CreateEditViewBase(new UserAccount(), (s, e) =>
        {
            this.Info("Completed");
            this.Info(s);
            this.Info(e);
        });

        EditViewDesignerService designerService = new EditViewDesignerService();
        designerService.SetControl(editView);
        editView.ViewDesigner = designerService;

        designer.LayoutFill(signin);

        // this.DesignerViewRef.OpenFile(@"C:\CsProject\Blazor_CommonModel\Projects\app.xml");
        // designer.OnNavSelected("Вход");
        designer.DesignMode = true;

    }
    private static void CreateUserBusinessFunctionsMenuView(UserContext user, DesignerView designer)
    {
        var userMenu = new MenuView()
            {
                Alignment = "right",
                Text = user.Account.Email,
                Icon = "person"
            };
        foreach (var kv in user.ActiveFunctions)
        {
            var todo = kv.Value;
            userMenu.MenuItems.Add(new()
                {
                    Text = kv.Key,
                    OnClick = (s, e) =>
                    {
                        todo();
                    }
                });
        }
        designer.MenuView.MenuItems.Add(userMenu);
        designer.DesignMode = false;
    }

}