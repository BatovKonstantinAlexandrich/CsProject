@inherits LayoutComponentBase
@inject NavMenuService navMenu
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@code 
{
    public MenuView Menu { get; set; } = new();
    public AppViewBase? AppViewRoot { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        navigationManager.LocationChanged += this.OnLocationChanged;
    }
    public void OnLocationChanged(object sender, LocationChangedEventArgs evt)
    {
        var uri = evt.Location;
        this.Info(uri);

        AppViewRoot = new AppViewBase();
        AppViewRoot.LayoutFill(AppViewRoot.CreateText(uri));
        AppViewRoot.Top = Menu;
        Menu.MenuItems.Clear();
        Menu.MenuItems.AddRange(navMenu.GetPageMenu(uri));
    }
}

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<ContextMenuHost />

<MudLayout>    
    <MudMainContent Class="pt-2">
        
        @if (AppViewRoot is not null)
        {

            
            <div style="position: fixed; width: 100%; height: 100%;">
                <ContainerControl FullSize="@true" ViewModel="@(AppViewRoot)">
                    <NavMenu></NavMenu>
                </ContainerControl>
            </div>
        }
        else
        {
            @Body
        }        
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
