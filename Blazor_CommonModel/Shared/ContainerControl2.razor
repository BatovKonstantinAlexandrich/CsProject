@code {
    private string _lastDialogResult = string.Empty;
    private string _lastMenuAction = string.Empty;

    private async Task ShowMessageAsync()
    {
        await ModalService.ShowMessageAsync("Информация", "Это модальное окно открыто через IAppModalService.");
        _lastDialogResult = "Закрыто окно сообщения.";
    }

    private async Task ShowConfirmAsync()
    {
        var confirmed = await ModalService.ShowConfirmAsync(
            "Подтверждение",
            "Вы действительно хотите выполнить действие?");

        _lastDialogResult = confirmed ? "Пользователь подтвердил действие." : "Пользователь отменил действие.";
    }

    private async Task ShowInputDialogAsync()
    {
        var parameters = new DialogParameters<DemoInputDialog>
        {
            { x => x.Label,         "Название элемента" },
            { x => x.InitialValue,  "Новый элемент" }
        };
        var dp = new Dictionary<string, object>();        var value = await ((AppModalService)ModalService).ShowDialogAsync<DemoInputDialog, string>(
            "Редактирование",
            parameters);

        _lastDialogResult = value is null
            ? "Диалог ввода отменён."
            : $"Сохранено значение: «{value}»";
    }

    private Task OpenContextMenuAsync(MouseEventArgs e)
    {
        var entities = this.ViewModel.ContextMenu.Items.Select(menuItem => new MenuItemItem<object>()
        {
            Text = menuItem.Label,
            OnClick = menuItem.OnClick,
            Todo = menuItem.OnClick
            
        }).ToArray().ToList();

        return ContextMenuService.ShowAsync(entities, new ActionModels.MouseEventArgs()
            {
                X = (int)e.ClientX,
                Y = (int)e.ClientY
        }, entry =>
        {
            _lastMenuAction = $"Выбран пункт: «{entry.Text}»";
            entry.OnClick(this, new EventArgs());
            entry.Todo(this, new EventArgs());
            Snackbar.Add(_lastMenuAction, Severity.Normal);
            return Task.CompletedTask;
        });
    }
}
