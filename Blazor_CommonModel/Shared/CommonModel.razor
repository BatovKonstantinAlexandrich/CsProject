    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();       
        if (this.Model is null)
        {
            this.Model = new ButtonView();
        }
        if (this.Type is null && Model is not null)
        {
            this.Type = this.Model.GetTypeName();
        }
        this.Info(nameof(OnInitializedAsync)+" "+this.GetTypeName() + " " + ViewModel.GetTypeName());
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        this.ViewModel = this.Model;         
        if (Model is not null)
        {
            this.Type = this.ViewModel.Name is not null?
                this.ViewModel.Name: this.ViewModel.GetType().GetTypeName();            
        }
        else
        {
            this.Type = null;
        }
        this.Info(nameof(OnParametersSetAsync) + " " + this.GetTypeName() + " " + ViewModel.GetTypeName());
    }



    /// <summary>
    ///
    /// </summary>
    public IComponentBase<TViewModel, TViewControl> TryBindComponent<TViewModel, TViewControl>(TViewModel viewModel)
        where TViewModel: AppViewBase
        where TViewControl: WebComponentBase

    {
        try
        {
            var types = ServiceFactory.Get().GetTypesImplements<IComponentBase<TViewModel, TViewControl>>();
            var componentType = types.Where(t => t != typeof(TViewControl)).FirstOrDefault();

            this.Info(componentType.GetTypeName() + $" выбран для связывания {typeof(IComponentBase<TViewModel, TViewControl>).GetTypeName()}");
            if (componentType is not null)
            {
                TViewControl viewControl = this.Cast<TViewControl>();
                return componentType.New<IComponentBase<TViewModel, TViewControl>>(new object[] { viewModel, viewControl });
            }
            else
            {
                throw new Exception($"Не удалось найти подходящий компонент для связывания {typeof(IComponentBase<TViewModel, TViewControl>).GetTypeName()}");
            }
        }
        catch (Exception ex)
        {
            this.Error($"{nameof(CommonModel.TryBindComponent)}<{typeof(TViewModel).GetTypeName()},{typeof(TViewControl).GetTypeName()}>(){ex.Message}");
            return null;
        }
    }

}






