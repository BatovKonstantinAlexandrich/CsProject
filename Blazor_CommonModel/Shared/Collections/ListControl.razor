@inherits WebControlBase<ListView,ListControl>
@using MudBlazor 
@code
{
    [Parameter]
    public ListView Model { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();        
        this.ViewModel = this.Model;
    }
}
@if (Model is null)
{
    <MudAlert>Model не задан</MudAlert>
}
else
{
    <div class="list-selection-view" style="min-width:@(Model.MinWidth)px; min-height:@(Model.MinHeight)px;">

        @if (!string.IsNullOrWhiteSpace(Model.Text))
        {
            <MudText Typo="Typo.h6" Class="d-flex align-center gap-2 mb-2">
                @if (!string.IsNullOrWhiteSpace(Model.Icon))
                {
                    <MudIcon Icon="@Model.Icon" Size="MudBlazor.Size.Medium" />
                }
                @Model.Text
            </MudText>
        }

        <MudList T="Option"
            @bind-SelectedValue="@(Model.SelectedOption)"
            
            Dense="true"
            Class="pa-0">

                @foreach (Option item in Model.Options)
                {
                    <MudListItem T="Option"
                    Value="@item"     >
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body1">@item.Value</MudText>
                            @if (!string.IsNullOrWhiteSpace(item.Item?.GetDescription()))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @item.GetDescription()
                                </MudText>
                            }
                        </div>
                    </MudListItem>
                }
            </MudList> 
    </div>
}
 