@using System.Drawing
@inherits BaseComponent
@inject IServiceProvider serviceProvider
@inject IClientAPI clientApi
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@implements IClientAPI

@code
{
    public override bool IsDisposed { get; set; } = false;

    public void NavigateTo(string href)
    {        
        navigationManager.NavigateTo(href);
    }

    public bool AddEventListener(string id, string type, string js)
    {
        return clientApi.AddEventListener(id, type, js);
    }

    public string Callback(string action, params string[] args)
    {
        return clientApi.Callback(action, args);
    }

    public bool ConfirmDialog(string Title, string Text)
    {
        return clientApi.ConfirmDialog(Title, Text);
    }

    public bool CreateEntityDialog(string Title, string Entity)
    {
        return clientApi.CreateEntityDialog(Title, Entity);
    }

    public bool DispatchEvent(string id, string type, object message)
    {
        return clientApi.DispatchEvent(id, type, message);
    }

    public string Eval(string js)
    {
        return clientApi.Eval(js);
    }

    public Point GetMousePosition()
    {
        return clientApi.GetMousePosition();
    }

    public string HandleEvalResult(Func<object, object> handle, string js)
    {
        return clientApi.HandleEvalResult(handle, js);
    }

    public bool InfoDialog(string Title, string Text, string Button)
    {
        return clientApi.InfoDialog(Title, Text, Button);
    }

    public object InputDialog(string Title, object Properties)
    {
        return clientApi.InputDialog(Title, Properties);
    }

    public string OnConnected(string token)
    {
        return clientApi.OnConnected(token);
    }

    public Point PointToClient(Point point)
    {
        return clientApi.PointToClient(point);
    }

    public bool RemoteDialog(string Title, string Url)
    {
        return clientApi.RemoteDialog(Title, Url);
    }

    public void ShowHelp(string Text)
    {
        clientApi.ShowHelp(Text);
    }

    public void ShowSnakBar(string title)
    {
        clientApi.ShowSnakBar(title);
    }

    public Task<bool> ShowView<TAppView>(string title, TAppView model, Action<bool, TAppView> oncompleted) where TAppView : AppViewBase
    {
        return clientApi.ShowView(title, model, oncompleted);
    }

    public void SubmitDialog(string title, object control, Action<object> value)
    {
        clientApi.SubmitDialog(title, control, value);
    }

    [Parameter]
    public AppViewBase RootViewModel { get; set; }

    public IServiceProvider BaseServiceProvider { get; set; }

    [Parameter]
    public override RenderFragment ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Info("OnInitializedAsync");
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        this.BaseServiceProvider = serviceProvider;
        if (this.RootViewModel is not null)
        {
            this.RootViewModel.control = this;
        }        
    }



    public void SubmitDialog(string title, Blazor_CommonModel.Shared.BaseComponent ctrl, Action<object> value)
    {
        clientApi.SubmitDialog(title, ctrl, value);
    }            
}
@if (ChildContent is not null)
{
    @ChildContent
}

<MudFileUpload T="IBrowserFile" @ref="_fileUpload" FilesChanged="HandleFileSelected" Accept=".png,.jpg,.pdf" Hidden="true" />

@code {
    private MudFileUpload<IBrowserFile>? _fileUpload;
    private IBrowserFile? _selectedFile;

    // Этот метод вызывается по нажатию кнопки
    public async Task OpenFileDialog(Action<(string, string, byte[])> oncompleted=null)
    {
        OnOpenFileCompleted = oncompleted;
        if (_fileUpload != null)
        {
            // Программный вызов диалога выбора файла
            await _fileUpload.OpenFilePickerAsync();
        }
    }


    public Action<(string, string, byte[])> OnOpenFileCompleted;


    private async Task HandleFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        try{

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024 * 50);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            byte[] bytes = ms.ToArray();
            if (OnOpenFileCompleted is not null)
            {
                OnOpenFileCompleted((file.ContentType, file.Name, bytes));
            }
        }
        catch(Exception ex)
        {
            this.Error(ex);
        }
    }
}