@code
{


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        if(ViewModel is null)
        {
            //throw new Exception("Не задана ссылка на ViewModel");
            this.Warn("Не задана ссылка на ViewModel");
        }
        this.OnRendered += async () => {
            await Task.CompletedTask;
        };
        this.ContainerControlRef = this;
    }

    public override void AfterInit() {
        base.AfterInit();
        // if(this.ViewHashCode != this.GetHashCode())
        // {
        //     throw new Exception("Изменился контекст элемента управления, гнобходима проверка на повторное выполнение кrazor компонентов");
        // }


        this.Eval("alert(this.id)");
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (this.ViewModel is not null)
        {
            var p = ViewModel;
            if (this.ViewModel.Controls.Any(ctrl => ctrl.Parent != p)){
                throw new Exception($"{this.ViewModel.GetTypeName()} => сылка на родителя страная {this.ViewModel.Controls.Where(ctrl => ctrl.Parent != p).Select(p=>p.GetTypeName()).ToJson()}");
            }

            this.ViewHashCode = this.ViewModel.GetHashCode();            
            AppProviderService.GetInstance().AddServiceImplementation<IAppModalService>(
                provider.Get<IAppModalService>()
            );
            if (this.ViewModel.GetAppRootView() is null)
            {
                
                this.Error(this.ViewModel.GetParentViews<AppViewBase>().Select(p => p.GetTypeName()).ToList().ToJson());
                //throw new Exception(this.ViewModel.GetTypeName()+" не привязан к корню");
            }
        }
    }

}

@code 
{
    private string _lastDialogResult = string.Empty;
    private string _lastMenuAction = string.Empty;

    private async Task ShowMessageAsync()
    {
        await ModalService.ShowMessageAsync("Информация", "Это модальное окно открыто через IAppModalService.");
        _lastDialogResult = "Закрыто окно сообщения.";
    }

    private async Task ShowConfirmAsync()
    {
        var confirmed = await ModalService.ShowConfirmAsync(
            "Подтверждение",
            "Вы действительно хотите выполнить действие?");

        _lastDialogResult = confirmed ? "Пользователь подтвердил действие." : "Пользователь отменил действие.";
    }

    private async Task ShowInputDialogAsync()
    {
        var parameters = new DialogParameters<DemoInputDialog>
        {
            { x => x.Label,         "Название элемента" },
            { x => x.InitialValue,  "Новый элемент" }
        };
        var dp = new Dictionary<string, object>();        var value = await ((AppModalService)ModalService).ShowDialogAsync<DemoInputDialog, string>(
            "Редактирование",
            parameters);

        _lastDialogResult = value is null
            ? "Диалог ввода отменён."
            : $"Сохранено значение: «{value}»";
    }

    private Task OpenContextMenuAsync(MouseEventArgs e)
    {
        var entities = this.ViewModel.ContextMenu.Items.Select(menuItem => new MenuItemItem<object>()
        {
            Text = menuItem.Label,
            OnClick = menuItem.OnClick,
            Todo = menuItem.OnClick
            
        }).ToArray().ToList();

        entities.AddRange(this.ViewModel.ContextMenuPublic.Items.Select(menuItem => new MenuItemItem<object>()
        {
            Text = menuItem.Label,
            OnClick = menuItem.OnClick,
            Todo = menuItem.OnClick

        }).ToArray().ToList());


        return ContextMenuService.ShowAsync(entities, new ActionModels.MouseEventArgs()
            {
                X = (int)e.ClientX,
                Y = (int)e.ClientY
        }, entry =>
        {
            _lastMenuAction = $"Выбран пункт: «{entry.Text}»";
            entry.OnClick(this, new EventArgs());
            entry.Todo(this, new EventArgs());
            Snackbar.Add(_lastMenuAction, Severity.Normal);
            return Task.CompletedTask;
        });
    }
