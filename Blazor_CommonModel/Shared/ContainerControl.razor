    public void OnControlInited(BaseComponent control)
    {
        try
        {
            ViewModel.OnChange += evt => this.StateHasChanged();
            if (this.ViewModel.control is null)
            {
                this.ViewModel.control = control;
            }
            else
            {
                if (this.ViewModel.control != control)
                {
                    this.Warn($"{this.ViewModel.control.GetTypeName()} != {control.GetTypeName()}");
                }
            }
            //TODO validate hashcode
            this.ViewModel.control.Controls.Add(control);
        }
        catch(Exception ex)
        {
            this.Error(nameof(OnControlInited)+" "+ex);
        }
    }

    [Parameter]
    public override IControlBase Parent { get; set; }

    public IEnumerable<ViewNode> GetReversedControls()
    {
        var list = ViewModel.Controls.ToList();
        list.Reverse();
        return list;
    }
}
@try
{
    @if(ViewModel is null )
    {
        <MudAlert>@(GetType().GetTypeName()) Не установлен обязательный параметр @nameof(ViewModel)</MudAlert>
    }
    else
    {
        <span style="max-width: @(ViewModel.MaxWidth)px; display: flex; flex-direction: column; @(FullSize?"width: 100%; height: 100%;":FullWidth?"width: 100%;":FullHeight?"height:100%;":"") @((ViewModel is not null && ViewModel.DesignMode? "border: 0px solid black;":""))"
        class="@(this.ViewModel.GetContainerCssClassName())"
        id="@(this.ViewModel.GetContainerDomId())"

        @onkeypress="@(evt=>{ ViewModel.OnKeyPressed(this,new(){ KeyChar=evt.Key }); })"
        @onmouseleave="OnMouseLeaveAspNet"
        @onmouseenter="OnMouseEnterAspNet"
        @ondrag="OnDragAspNet"
        @ondrop="OnDropAspNet"
        @ondragenter="OnDragEnterAspNet"
        @ondragleave="OnDragLeaveAspNet"
        @ondblclick="OnMouseDoubleClickAspNet"
        @oncontextmenu="OpenWorkspaceMenu"
        @oncontextmenu:stopPropagation="true"
        @oncontextmenu:preventDefault="true" >

            <TransclusionPanel FullSize="@true"> 
                <Header> 
                    @if (ViewModel.Top is not null) 
                    {
                        <ContainerControl ViewModel="@((AppViewBase)ViewModel.Top)" Width="@(100)" WidthUnit="@("%")" FullWidth="@true" OnInit="@(evt => ViewModel.Top.Cast<AppViewBase>().control=evt )"></ContainerControl>
                    } 

                </Header> 
                <Left>
                    @if (ViewModel.Left is not null) 
                    {
                        <ContainerControl ViewModel="@((AppViewBase)ViewModel.Left)" Height="@(100)" HeightUnit="@("%")" FullHeight="@true" OnInit="@(evt => ViewModel.Left.Cast<AppViewBase>().control=evt )"></ContainerControl>
                    } 
                </Left>
                <Center>
                    <span style="@(FullSize? "width: 100%; height: 100%;":FullWidth?"width: 100%;":FullHeight?"height:100%;":"")">
                        @if (Center is not null)
                        {
                            @Center
                        }
                        @if (ViewModel is not null)
                        {
                            <CommonModel Model="@ViewModel" @ref="CommonModelRef"  FullWidth="@FullWidth" FullHeight="@FullWidth">
                                <TransclusionPanel FullSize="true">
                                    <Header>

                                        @foreach (AppViewBase childView in GetReversedControls().Where(c => c.Cast<AppViewBase>().Dock == "Top"))
                                        {
                                            <ContainerControl ViewModelParent="@ViewModel" ViewModel="@childView" OnInit="@(evt => childView.control=evt )" Width="@(100)" WidthUnit="@("%")" FullWidth="@true"></ContainerControl>
                                        }
                                    </Header>
                                    <Left>
                                        @foreach (AppViewBase childView in ViewModel.Controls.Where(c => c.Cast<AppViewBase>().Dock == "Left"))
                                        {
                                            <ContainerControl ViewModelParent="@ViewModel" ViewModel="@childView" OnInit="@(evt => childView.control=evt )" Height="@(100)" HeightUnit="@("%")" FullHeight="@true"></ContainerControl>
                                        }
                                    </Left>
                                    <Center>                                        
                                        @foreach (AppViewBase childView in ViewModel.Controls.Where(c => c.Cast<AppViewBase>().Dock == "Fill" || c.Cast<AppViewBase>().Dock == "None"))
                                        {
                                            @if (childView.Dock == "Fill")
                                            {
                                                <ContainerControl ViewModelParent="@ViewModel" ViewModel="@childView" OnInit="@(evt => childView.control=evt )" Width="@(100)" WidthUnit="@("%")" Height="@(100)" HeightUnit="@("%")" FullSize="@true"></ContainerControl>
                                            }
                                            else
                                            {
                                                <ContainerControl ViewModelParent="@ViewModel" ViewModel="@childView" OnInit="@(evt => childView.control=evt )"></ContainerControl>
                                            }
                                        }
                                    </Center>
                                    <Right>
                                        @foreach (AppViewBase childView in ViewModel.Controls.Where(c => c.Cast<AppViewBase>().Dock == "Right"))
                                        {
                                            <ContainerControl ViewModelParent="@ViewModel" ViewModel="@childView" OnInit="@(evt => childView.control=evt )" Height="@(100)" HeightUnit="@("%")" FullHeight="@true"></ContainerControl>
                                        }
                                    </Right>
                                    <Footer>
                                        @foreach (AppViewBase childView in ViewModel.Controls.Where(c => c.Cast<AppViewBase>().Dock == "Bottom"))
                                        {
                                            <ContainerControl ViewModelParent="@ViewModel" ViewModel="@childView" OnInit="@(evt => childView.control=evt )" Width="@(100)" WidthUnit="@("%")" FullWidth="@true"></ContainerControl>
                                        }
                                    </Footer>
                                </TransclusionPanel>
                            </CommonModel>
                        }
                    </span>
                </Center>
                <Right> 
                    @if (ViewModel.Right is not null) 
                    {
                        <ContainerControl ViewModel="@((AppViewBase)ViewModel.Right)" Height="@(100)" HeightUnit="@("%")" FullHeight="@true" OnInit="@(evt => ViewModel.Right.Cast<AppViewBase>().control=Right=evt )"></ContainerControl>
                    } 
                </Right> 
                <Footer> 
                    @if (ViewModel.Bottom is not null) 
                    {
                        <ContainerControl FullWidth="@true" ViewModel="@((AppViewBase)ViewModel.Bottom)" Width="@(100)" WidthUnit="@("%")" OnInit="@(evt => ViewModel.Bottom.Cast<AppViewBase>().control=Bottom=evt )"></ContainerControl>
                    } 
                </Footer> 
            </TransclusionPanel> 
        </span>

        <MudMenu @ref="_menu" PositionAtCursor="true" Dense="true" AnchorOrigin="Origin.TopLeft">
            <MudMenuItem Label="@ContextTitle" Disabled="true" />
            <MenusItem Item="@ContextMenu" IsRoot="@true"></MenusItem>
        </MudMenu>
    }
}
catch(Exception ex)
{
    <ErrorControl Exception="@ex" Catcher="@(GetType().GetTypeName())" Parameters="@(new Dictionary<string,object>(){ { nameof(ViewModel), ViewModel }})"></ErrorControl>
}

@code {
    public ContextView ContextMenu { get; set; } = new()
    {
        Label = "file" 
    };

    public string ContextTitle { get; set; } = "Меню";
    private MudMenu _menu = null!;

    protected override void OnInitialized()
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
    }

    private Task OpenWorkspaceMenu(MouseEventArgs args)
    {
        // this.Info("OpenWorkspaceMenu => " + ViewModel.GetAppRootView().FocusedViews.Select(v => v.GetTypeName()).ToJson());
        // this.Info("OpenWorkspaceMenu => " + ViewModel.GetTypeName());
        // await Task.CompletedTask;
        var view = ViewModel.GetAppRootView().FocusedViews.LastOrDefault();
        ContextTitle = view.GetLabel();

        ContextMenu.Items.Clear();
        ContextMenu.Items.AddRange(view.ContextMenu.Items);
        ContextMenu.Items.AddRange(view.ContextMenuPublic.Items);

        StateHasChanged();
        return OpenMenu(args);
    }

    private async Task OpenMenu(MouseEventArgs args)
    {
        await _menu.OpenMenuAsync(args);
    }

}

