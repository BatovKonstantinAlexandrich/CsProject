@inherits BaseComponent
@code 
{
    [Parameter]
    public bool FullSize { get; set; } = false;
    [Parameter]
    public bool FullWidth { get; set; } = false;
    [Parameter]
    public bool FullHeight { get; set; } = false;
    [Parameter]
    public override RenderFragment? ChildContent { get; set; }
}

<div style="display: flex; flex-direction: row;  @(FullSize?"width: 100%; height: 100%;":FullWidth?"width: 100%;":FullHeight?"height:100%;":"")">
    <div style="align-self: center; margin: auto;  @(FullSize?"width: 100%; height: 100%;":FullWidth?"width: 100%;":FullHeight?"height:100%;":"")">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
    </div>
</div>
