
@inherits WebControlBase<ScrollView, IScrollControl>
@implements IScrollControl
@code 
{
    [Parameter]
    public ScrollView Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        this.OnRendered += async () => {
            await EvalAsync<string>($"document.getElementById('p_control_{Model.GetHashCode()}').style.height=document.getElementById('p_control_{Model.GetHashCode()}').parentNode.getBoundingClientRect().height+'px';");           
        };
    }
}
<div id="p_control_@Model.GetHashCode()" style="height: 0px; width: 100%; overflow-y: auto;" >
    @foreach (AppViewBase childView in Model.Controls)
    {
        <ContainerControl ViewModel="@childView"></ContainerControl>
    }
</div>
