@using Console_CommonModel.CommonLib.LibViews.AppViews.InputModule
@inherits WebControlBase<InputFilePathView,InputFilePathControl>
InputFilePathControl

@code{
    [Parameter]
    public override AppViewBase ViewModel { get; set; }
     
}
@using MudBlazor

<MudFileUpload T="IBrowserFile" FilesChanged="HandleFileSelected" Accept=".png,.jpg,.pdf">
    <ActivatorContent>
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
            Выбрать файл
        </MudButton>
    </ActivatorContent>
</MudFileUpload>

@if (selectedFile != null)
{
    <MudText Typo="Typo.body1" Class="mt-4">
        Выбран файл: <strong>@selectedFile.Name</strong> (@selectedFile.Size байт)
    </MudText>
}

@code {
    private IBrowserFile? selectedFile;

    private void HandleFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        // Здесь можно добавить логику обработки файла
    }
}