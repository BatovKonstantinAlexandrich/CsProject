@using Console_CommonModel.CommonLib.LibViews.AppViews.InputModule
@inherits WebControlBase<InputDateTimeView,InputDateTimeControl>
@using MudBlazor
@using MudBlazor.Components

InputDateTimeControl

@code{
    [Parameter]
    public override AppViewBase ViewModel { get; set; }
    public DateTime Value { get; set; } = DateTime.Now;

    protected override async Task OnInitializedAsync(){
        await base.OnInitializedAsync();
    }
}
<MudCard>
    @if(!Initiallized)
    {
        <MudProgressCircular>Выполняется инициализация</MudProgressCircular>
    }
    else
    {
        if(ErrorMessage != "" )
        {
            <MudAlert>@ErrorMessage</MudAlert>
        }
        else
        {
            <CustomTextBox InputType="@MudBlazor.InputType.Date" Value="@Value.ToString()" />
        }
    }
</MudCard>