@using Blazor_CommonModel.Shared.Collections
@using Console_CommonModel.CommonLib.LibViews.ViewEvents
@inject Microsoft.Extensions.Logging.ILogger<ValidationForm> Logger
@inherits BaseComponent
@code{
    [Parameter]
    public global::InputFormModel Model { get; set; }
    public InputFormModel f { get; set; }

    [Parameter]
    public bool Border { get; set; }

    [Parameter]
    public EventCallback OnValidated { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }
}
@if (Model == null)
{
    <MudProgressCircular>Выполняется инициализация</MudProgressCircular>

}
else
{

    <div class="btn"
    style="width: 100%; height: 90%;
                   position: fixed;
                   overflow-y: auto;
                   padding: 20px;
                   border-radius: 2px; box-shadow: 0px 4px 3px -2px rgba(0, 0, 0, 0.4), 0px 2px 2px 0px rgba(0, 0, 0, 0.24), 0px 2px 6px 0px rgba(0, 0, 0, 0.22);">
        <p class="text-body-header">@Model.Title</p>
        <div class="text-black-50 text-info">@Model.Description</div>
        <form>
            <ul class="list-group">
                @foreach (var field in Model.FormFields)
                {
                    <li class="list-group-item">
                        <FormControl Model="@field" 
                        AfterInput="@OnPropertyChanged"
                        OnEvent="@((p=>{ OnEventSubmited(p); }))"></FormControl>

                    </li>
                }

            </ul>
        </form>

        <div style="padding: 5px;" align="right"> @ChildContent </div>
    </div>
}
@functions
{

    public void OnPropertyChanged(InputEvent evt)
    {
        try{
            var results = Model.Validate();
            foreach (var kv in results)
            {
                kv.Value.Clear();

                kv.Value.Clear();
                kv.Value.AddRange(kv.Value);
            }
        }catch(Exception ex)
        {

        }

    }
}