@using Blazor_MyApp.Services
@using Blazor_MyApp.Services.ContextServices
@inherits LayoutComponentBase
@inject LayoutService layoutService
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@inject HttpClient http
@inject INavMenuService nav
@code
{
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await layoutService.OnInitiallizedAsync();
        navigationManager.LocationChanged += this.OnLocationChanged;
        this.OnLocationChanged(navigationManager.Uri);
    }
    public void OnLocationChanged(string uri)
    {
        layoutService.Menus.Clear();

        var menus = nav.GetPageLinks(uri);
        layoutService.Menus.AddRange(menus);
         
    }
    public void OnLocationChanged(object sender, LocationChangedEventArgs evt)
    {
        var uri = evt.Location;
        this.OnLocationChanged(uri);
    }
}
<div class="page">
    <div class="sidebar">
        <NavMenu Menus="@layoutService.Menus" />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>            
        </div>

        <article class="content px-4">
            <button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>


@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
        

    }
}
