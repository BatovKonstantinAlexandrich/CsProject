@implements IDisposable
@inject IMenuService MenuService
@inject IStationService StationService
@inject CityState CityState
@inject UserSession Session
@inject NavigationManager Navigation

<header id="top" class="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="/" @onclick="Close">
            <span class="logo" aria-hidden="true">
                <span>euro</span>
                <span>auto</span>
            </span>
            <span class="logo-bar"></span>
            <span class="logo-sub">СЕРВИС</span>
        </a>

        <button type="button" class="nav-toggle" aria-label="Открыть меню" @onclick="ToggleMenu">
            <span></span><span></span><span></span>
        </button>

        <nav class="main-nav @(menuOpen ? "open" : null)" aria-label="Основное меню">
            <div class="drop">
                <button type="button" class="nav-link city-link" @onclick='() => Toggle("city")'>
                    <EaIcon Name="pin" CssClass="pin" />
                    <span>@CityState.Current</span>
                    <i class="caret"></i>
                </button>
                <div class="panel @(opened == "city" ? "show" : null)">
                    @foreach (var city in StationService.GetCities())
                    {
                        <a href="@($"/stations?city={Uri.EscapeDataString(city)}")" @onclick="() => ChooseCity(city)">@city</a>
                    }
                </div>
            </div>

            @foreach (var item in MenuService.GetMainMenu())
            {
                if (item.Children is { Count: > 0 })
                {
                    <div class="drop">
                        <button type="button" class="nav-link" @onclick="() => Toggle(item.Title)">
                            <span>@item.Title</span>
                            @if (item.Marked)
                            {
                                <EaIcon Name="external" CssClass="ext" />
                            }
                            <i class="caret"></i>
                        </button>
                        <div class="panel @(opened == item.Title ? "show" : null)">
                            @foreach (var child in item.Children)
                            {
                                if (child.Children is { Count: > 0 })
                                {
                                    <div class="sub">
                                        <a class="sub-title" href="@child.Href" @onclick="Close">@child.Title</a>
                                        @foreach (var leaf in child.Children)
                                        {
                                            <a href="@leaf.Href" @onclick="Close">@leaf.Title</a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <a href="@child.Href" @onclick="Close">@child.Title</a>
                                }
                            }
                        </div>
                    </div>
                }
                else
                {
                    <a class="nav-link" href="@item.Href" @onclick="Close">
                        <span>@item.Title</span>
                        @if (item.Marked)
                        {
                            <EaIcon Name="external" CssClass="ext" />
                        }
                    </a>
                }
            }
        </nav>

        <div class="header-actions @(menuOpen ? "open" : null)">
            <a class="nav-link" href="/login" @onclick="Close">@(Session.IsAuthenticated ? Session.Name : "Войти")</a>
            <a class="btn-call" href="/callback" @onclick="Close">Заказать звонок</a>
        </div>
    </div>
</header>

@code {
    private bool menuOpen;
    private string? opened;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnNavigate;
        CityState.Changed += OnChanged;
        Session.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnNavigate(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(Close);

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void Toggle(string key) => opened = opened == key ? null : key;

    private void ChooseCity(string city)
    {
        CityState.Select(city);
        Close();
    }

    private void Close()
    {
        menuOpen = false;
        opened = null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnNavigate;
        CityState.Changed -= OnChanged;
        Session.Changed -= OnChanged;
    }
}
