@inject IContentService Content

<section class="wrap channel-grid">
    @foreach (var card in Content.GetChannels())
    {
        <article>
            <h2>@card.Title</h2>
            <p>@card.Text</p>
            <a class="text-link" href="@card.Href">@card.Button</a>
        </article>
    }
</section>
