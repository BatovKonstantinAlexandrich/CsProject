@inherits ViewInteractionComponentBase

<MudPaper Class="pa-3 view-hierarchy" Elevation="1">
    @if (!string.IsNullOrWhiteSpace(Data.Title))
    {
        <MudText Typo="Typo.h6" Class="mb-3">@Data.Title</MudText>
    }

    @if (Data.Roots.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Иерархия пуста.</MudAlert>
    }
    else
    {
        @foreach (var root in Data.Roots)
        {
            <HierarchyViewNode Node="root"
                               Level="0"
                               EnableDragDrop="EnableDragDrop"
                               GetRowClass="GetRowClass"
                               OnSelect="SelectNodeAsync"
                               OnDragStart="HandleNodeDragStart"
                               OnDragOver="HandleNodeDragOver"
                               OnDrop="HandleNodeDrop" />
        }
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public ViewHierarchyData Data { get; set; } = new();

    private string? _dragSourceId;
    private ViewItemNode? _dragSourceItem;

    protected override void OnInitialized() => ViewKind = ViewKind.Hierarchy;

    private Task SelectNodeAsync(ViewItemNode node) => NotifySelectionAsync(node.Id, node);

    private async Task HandleNodeDragStart(ViewItemNode node)
    {
        _dragSourceId = node.Id;
        _dragSourceItem = node;
        await NotifyDragDropAsync(ViewDragDropPhase.DragStart, node.Id, null, node);
    }

    private Task HandleNodeDragOver(ViewItemNode node) =>
        NotifyDragDropAsync(ViewDragDropPhase.DragOver, _dragSourceId, node.Id, _dragSourceItem, node);

    private async Task HandleNodeDrop(ViewItemNode node)
    {
        await NotifyDragDropAsync(ViewDragDropPhase.Drop, _dragSourceId, node.Id, _dragSourceItem, node);
        _dragSourceId = null;
        _dragSourceItem = null;
    }
}
