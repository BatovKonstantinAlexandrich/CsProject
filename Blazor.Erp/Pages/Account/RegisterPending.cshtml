@page "/Account/RegisterPending"
@model BlazorErp.Pages.Account.RegisterPendingModel
@{
    ViewData["Title"] = "Заявка на рассмотрении";
    Layout = "_AccountLayout";
}

<div class="account-card">
    @if (Model.IsRejected)
    {
        <h2>Заявка отклонена</h2>
        <p class="account-card-subtitle">
            Ваша заявка на роль @Model.StaffRoleLabel в магазине «@Model.StoreName» была отклонена владельцем.
        </p>
        <p>Подробности могут быть в разделе <a href="/messages">Сообщения</a>.</p>
    }
    else if (Model.IsApproved)
    {
        <h2>Заявка одобрена</h2>
        <p class="account-card-subtitle">
            Вы можете работать @Model.StaffRoleLabel в магазине «@Model.StoreName».
        </p>
        <a href="/store" class="btn btn-primary w-100">Перейти в магазин</a>
    }
    else
    {
        <h2>Заявка отправлена</h2>
        <p class="account-card-subtitle">
            Ваша заявка на роль @Model.StaffRoleLabel в магазине «@Model.StoreName» отправлена владельцу.
        </p>
        <p>Ожидайте подтверждения. Уведомление придёт в <a href="/messages">Сообщения</a>.</p>
    }

    <p class="mt-3 text-center">
        <a href="/">На главную</a> · <a href="/Account/Logout">Выйти</a>
    </p>
</div>
