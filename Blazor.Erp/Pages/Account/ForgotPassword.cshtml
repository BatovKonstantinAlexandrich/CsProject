@page "/Account/ForgotPassword"
@model BlazorErp.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление доступа";
    Layout = "_AccountLayout";
}

<div class="account-card">
    <h2 class="text-center">Восстановление доступа</h2>
    <p class="account-card-subtitle text-center">
        Укажите email вашей учётной записи — мы отправим ссылку для сброса пароля.
    </p>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Отправить ссылку</button>
    </form>

    <p class="mt-3 text-center">
        <a href="/Account/Login">Вернуться ко входу</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
