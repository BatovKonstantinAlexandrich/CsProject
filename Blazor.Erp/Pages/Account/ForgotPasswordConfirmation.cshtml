@page "/Account/ForgotPasswordConfirmation"
@{
    ViewData["Title"] = "Проверьте почту";
    Layout = "_AccountLayout";
    var devResetLink = TempData["DevResetLink"] as string;
}

<div class="account-card text-center">
    <h2>Проверьте почту</h2>
    <p class="account-card-subtitle">
        Если указанный email зарегистрирован в системе, на него отправлена ссылка для сброса пароля.
    </p>

    @if (!string.IsNullOrEmpty(devResetLink))
    {
        <div class="alert alert-info text-start">
            <strong>Режим разработки:</strong> почта не настроена, используйте ссылку ниже.
            <div class="mt-2">
                <a href="@devResetLink">Сбросить пароль</a>
            </div>
        </div>
    }

    <a href="/Account/Login" class="btn btn-primary">Ко входу</a>
</div>
