@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-shell">
    <MudAppBar Elevation="2" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" Class="d-md-none" />
        <MudIcon Icon="@Icons.Material.Filled.Storefront" Class="mr-2 app-bar-icon" />
        <MudText Typo="Typo.h6" Class="app-bar-title">BlazorErp</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="auth">
                <MudText Typo="Typo.body2" Class="app-bar-user mr-4 d-none d-sm-inline">@auth.User.Identity?.Name</MudText>
                <MudButton Href="/account" Color="Color.Inherit" Variant="Variant.Text" Size="Size.Small">Кабинет</MudButton>
                <MudButton Href="/messages" Color="Color.Inherit" Variant="Variant.Text" Size="Size.Small">Сообщения</MudButton>
                <MudButton Href="/Account/Logout" Color="Color.Inherit" Variant="Variant.Text" Size="Size.Small">Выйти</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/Account/Login" Color="Color.Inherit" Variant="Variant.Text" Size="Size.Small">Войти</MudButton>
                <MudButton Href="/Account/Register" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="ml-2">Регистрация</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Mini" OpenMiniOnHover="true"
               ClipMode="DrawerClipMode.Always" Class="app-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-main">
        <AuthorizeView>
            <Authorized Context="auth">
                @if (auth.User.HasClaim(c => c.Type == DeveloperRolePreview.PreviewRoleClaimType))
                {
                    var previewRole = auth.User.FindFirst(DeveloperRolePreview.PreviewRoleClaimType)?.Value;
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ma-4 mb-0" Dense="true">
                        Режим просмотра: <strong>@RoleDisplayNames.GetDisplayName(previewRole!)</strong>.
                        <MudLink Href="/account">Изменить в кабинете</MudLink>
                    </MudAlert>
                }
            </Authorized>
        </AuthorizeView>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page-container py-6">
            @Body
        </MudContainer>
        <AppFooter />
    </MudMainContent>
</MudLayout>

<AuthorizeView>
    <Authorized>
        <MessageNotificationHost />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui">
    Произошла ошибка.
    <a href="" class="reload">Обновить</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
