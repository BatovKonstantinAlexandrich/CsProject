@using BlazorErp.Models
@using BlazorErp.Models.Enums
@using BlazorErp.Services

@if (Attachments.Any())
{
    <div class="news-attachments mt-3">
        @foreach (var attachment in Attachments.Where(a => a.MediaType == NewsAttachmentType.Image))
        {
            <figure class="news-attachment-image mb-3">
                <img src="@NewsMediaStorageService.GetPublicUrl(attachment)" alt="@attachment.OriginalFileName"
                     class="product-detail-image" style="max-height:240px;object-fit:cover" />
                <figcaption class="text-muted mt-1">@attachment.OriginalFileName</figcaption>
            </figure>
        }

        @foreach (var attachment in Attachments.Where(a => a.MediaType == NewsAttachmentType.Video))
        {
            <div class="news-attachment-video mb-3">
                <video controls class="w-100" style="max-height:360px">
                    <source src="@NewsMediaStorageService.GetPublicUrl(attachment)" type="@attachment.ContentType" />
                    Ваш браузер не поддерживает воспроизведение видео.
                </video>
                <div class="text-muted mt-1">@attachment.OriginalFileName</div>
            </div>
        }

        @{
            var files = Attachments.Where(a => a.MediaType == NewsAttachmentType.File).ToList();
        }
        @if (files.Count > 0)
        {
            <div class="news-attachment-files mb-2">
                <strong>Файлы:</strong>
                <ul class="mb-0">
                    @foreach (var attachment in files)
                    {
                        <li>
                            <a href="@NewsMediaStorageService.GetPublicUrl(attachment)" target="_blank" rel="noopener">
                                @attachment.OriginalFileName
                            </a>
                            <span class="text-muted">(@FormatFileSize(attachment.FileSize))</span>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public IEnumerable<NewsAttachment> Attachments { get; set; } = [];

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} Б";
        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:0.#} КБ";
        return $"{bytes / (1024.0 * 1024.0):0.#} МБ";
    }
}
