@inject IOptions<ExternalAppsOptions> ExternalAppsOptions

<MudPaper Class="pa-3 embedded-app-shell">
    <div class="stack-row mb-3" style="justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px">
        <div>
            <MudText Typo="Typo.h6">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo="Typo.body2" Class="text-muted">@Description</MudText>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Url))
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew"
                       Href="@Url" Target="_blank">Открыть в новой вкладке</MudButton>
        }
    </div>

    @if (string.IsNullOrWhiteSpace(Url))
    {
        <MudAlert Severity="Severity.Warning">
            URL приложения не настроен. Укажите адрес в секции <code>ExternalApps</code> файла appsettings.json.
        </MudAlert>
    }
    else
    {
        <iframe src="@Url" title="@Title" class="embedded-app-frame" loading="lazy"></iframe>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Url { get; set; } = string.Empty;
}
