    private static DateTime GetWeekStart(DateTime date)
    {
        var local = date.ToLocalTime().Date;
        var diff = (7 + (local.DayOfWeek - DayOfWeek.Monday)) % 7;
        return DateTime.SpecifyKind(local.AddDays(-diff), DateTimeKind.Local).ToUniversalTime();
    }

    private static string GetStatusLabel(AutoServiceAppointmentStatus status) => status switch
    {
        AutoServiceAppointmentStatus.Scheduled => "Запланирована",
        AutoServiceAppointmentStatus.Completed => "Выполнена",
        AutoServiceAppointmentStatus.Cancelled => "Отменена",
        _ => status.ToString()
    };
